{
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter server build && pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
