{
  "permissions": {
    "allow": [
      "Bash(pnpm lint*)",
      "Bash(pnpm format*)",
      "Bash(pnpm typecheck*)",
      "Bash(pnpm test*)",
      "Bash(pnpm build*)",
      "Bash(pnpm verify*)",
      "Bash(pnpm --filter web *)",
      "Bash(pnpm --filter server *)",
      "Bash(pnpm exec eslint*)",
      "Bash(pnpm exec prettier*)",
      "Bash(pnpm exec playwright test*)",
      "Bash(pnpm exec vitest run*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(gh pr create*)",
      "Bash(git reset --hard*)",
      "Bash(rm -rf*)",
      "Read(./.env*)"
    ]
  }
}
